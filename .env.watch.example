# Copy to the repository-root .env to build the official mobile app with its
# native watch companion. These are public build settings, not credentials.
T3CODE_WATCH_COMPANION=1
T3CODE_WATCH_BUNDLE_ID=com.matteozajac.T3Watch
T3CODE_WATCH_TEAM_ID=4TCJLR98Y5
APP_VARIANT=production

# The same public production identifiers documented in upstream .env.example.
# Sign in to T3 Connect on the iPhone; the watch reuses its connection.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
T3CODE_RELAY_URL=https://relay.t3.codes

# This paid-team fork keeps widgets and sharing, and disables upstream OTA and
# hosted APNs delivery. Do not set T3CODE_IOS_PERSONAL_TEAM=1: that flag is for
# Apple's free Personal Team and removes capabilities needed by this app.
# The production Clerk passkey/Apple configuration belongs to T3 Tools; login
# methods under this fork's identity require device validation.
